# ---------------------------------------------------------------------------
# TITAN AI Call Agent — environment configuration
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# --- LiveKit (real-time transport) ----------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM: Google Gemini 2.5 Flash -----------------------------------------
# Required. The Google plugin reads GOOGLE_API_KEY (not GEMINI_API_KEY).
GOOGLE_API_KEY=
# Optional overrides:
# LLM_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.95

# --- STT / TTS: Sarvam AI --------------------------------------------------
# Required for speech in/out.
SARVAM_API_KEY=
# Optional STT overrides (defaults: multilingual auto-detect, code-mixed):
# STT_MODEL=saaras:v3
# STT_LANGUAGE=unknown
# STT_MODE=codemix
# Optional TTS overrides (Sarvam synthesizes into one target language):
# TTS_MODEL=bulbul:v3
# TTS_TARGET_LANGUAGE=hi-IN
# TTS_SPEAKER=pooja   # must be compatible with TTS_MODEL (bulbul:v3): e.g. pooja, ritu, priya, kavya, neha

# --- Agent identity --------------------------------------------------------
# AGENT_NAME=my-agent
# ASSISTANT_NAME=TITAN
# USER_NAME=Abhi
# Persona: "receptionist" (hospital front desk, default) or "titan" (personal assistant).
# PERSONA=receptionist
# HOSPITAL_NAME=ABC Hospital
# Departments -> doctors directory used by the receptionist booking flow.
# DOCTORS_FILE=data/doctors.json

# --- Observability ---------------------------------------------------------
# LOG_LEVEL=INFO

# --- Calendar / booking ----------------------------------------------------
# Backend for the book_appointment tool: "memory" (default, in-process) or
# "google" (real Google Calendar events via a service account).
# CALENDAR_BACKEND=memory
# BUSINESS_TIMEZONE=Asia/Kolkata
# BUSINESS_HOURS_START=9          # first bookable hour (inclusive)
# BUSINESS_HOURS_END=18           # last bookable hour (exclusive)
# DEFAULT_APPOINTMENT_MINUTES=30
# When a requested slot is taken, how many nearby alternatives to offer, and how
# far (minutes) around the requested time to search first.
# ALTERNATIVE_SLOT_COUNT=3
# ALTERNATIVE_SEARCH_WINDOW_MINUTES=120
# Required only when CALENDAR_BACKEND=google (run `uv sync --extra calendar`):
# GOOGLE_CALENDAR_ID=you@example.com
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# --- Persistence (SQLite = primary app DB, Excel = staff report) -----------
# Both files auto-create on first booking. Relative paths resolve to the project root.
# DATABASE_FILE=data/titan.db
# EXCEL_FILE=data/appointments.xlsx

# --- Telephony (optional; wire later) --------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SIP_OUTBOUND_TRUNK_ID=

# --- Optional control-plane API --------------------------------------------
# API_HOST=0.0.0.0
# API_PORT=8000
